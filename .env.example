# ============================================================
# BucketSpace — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================================

# --- Telegram Storage (MTProto User Account & Phone Login) ---
# Obtain from https://my.telegram.org/apps
TELEGRAM_API_ID="your-telegram-api-id"
TELEGRAM_API_HASH="your-telegram-api-hash"

# --- API URL (Render backend for production, empty for local dev) ---
# In production, set this to your Render service URL (e.g. https://bucketspace-api.onrender.com)
# In local development, leave empty or omit — the browser uses same-origin
NEXT_PUBLIC_API_URL=""

# --- CORS (comma-separated origins allowed to call the API) ---
# Used by the middleware on the Render backend to allow cross-origin requests from Vercel frontend
CORS_ORIGINS="http://localhost:3000"

# --- Upload Configuration ---
# Maximum time (ms) for a single chunk upload before timeout (default: 300000 = 5 min)
UPLOAD_TIMEOUT_MS=300000

# --- Node Environment ---
NODE_ENV=development
