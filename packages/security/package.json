{
  "name": "@bucketspace/security",
  "version": "1.0.0",
  "private": true,
  "description": "OWASP-compliant envelope encryption vault and scrypt passcode hasher for BucketSpace",
  "main": "dist/index.js",
  "module": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@bucketspace/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.3"
  }
}
